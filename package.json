{
  "name": "qaworktoolkit",
  "version": "1.0.0",
  "description": "QA Work Toolkit",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "portable": "electron-builder --win portable",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ardiputracode/QAworktoolkit.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ardiputracode/QAworktoolkit/issues"
  },
  "homepage": "https://github.com/ardiputracode/QAworktoolkit#readme",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.6"
  },
  "build": {
    "appId": "com.qaworktoolkit.app",
    "productName": "QA Work Toolkit",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
